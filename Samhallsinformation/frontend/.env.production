# Produktionsbygget använder riktig backend, aldrig mockdata.
# (Tidigare true "tills backend är live" — backend är live sedan länge. Vercels
# miljövariabel VITE_USE_MOCK vinner om den finns; den här filen är skyddsnätet
# om variabeln skulle saknas.)
VITE_USE_MOCK=false

# Mock-UI (V3-20): fabricerad demo-data får aldrig nå riktiga användare, oavsett feature flags.
# Sätts bara till true i .env.local för lokal utveckling.
VITE_SHOW_MOCK_UI=false
